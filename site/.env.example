# A API escuta apenas no loopback por padrão.
HOST=127.0.0.1
PORT=4174

# Caminhos locais; não inclua credenciais neste arquivo.
ZSPEAK_DATA_FILE=./data/zspeak.json
ZSPEAK_DOWNLOAD_DIR=./downloads

# O catálogo mostra "em preparação" até uma URL HTTPS ser configurada.
# ZSPEAK_MACOS_DOWNLOAD_URL=https://downloads.example.com/zspeak.dmg
# ZSPEAK_WINDOWS_DOWNLOAD_URL=https://downloads.example.com/zspeak.exe
