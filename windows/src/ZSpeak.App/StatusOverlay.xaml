<Window x:Class="ZSpeak.App.StatusOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="270" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False">
    <Border Background="#F20A1724" BorderBrush="#596D82" BorderThickness="1" CornerRadius="22" Padding="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#17304A" BorderBrush="#4F7DAA" BorderThickness="1">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE720;" Foreground="#73ADFF" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0"><TextBlock x:Name="FocusedAppText" Text="Aplicativo em foco" Foreground="#F5F7FA" FontWeight="SemiBold"/><TextBlock Text="zspeak" Foreground="#8090A0" FontSize="11"/></StackPanel>
                </StackPanel>
                <Border x:Name="StatusPill" Grid.Column="1" Background="#302024" BorderBrush="#A54B53" BorderThickness="1" CornerRadius="14" Padding="11,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF4D52" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="StatusLabel" Text="AO VIVO" Foreground="#FF777B" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="DurationText" Text="00:00" Foreground="#FFB3B5" FontSize="11" Margin="8,0,0,0"/></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" x:Name="WaveformRegion" Margin="8,22,8,16" Height="70" VerticalAlignment="Center">
                <StackPanel x:Name="WaveformBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" x:Name="MicrophoneRow">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE720;" Foreground="#8395A7" FontSize="12" Margin="0,1,7,0"/><TextBlock x:Name="MicrophoneText" Foreground="#9CAAB8" FontSize="12" Text="Microfone"/></StackPanel>
                <TextBlock Grid.Column="1" Text="Esc para cancelar" Foreground="#788999" FontSize="12"/>
            </Grid>

            <Border x:Name="ProcessingCard" Grid.Row="3" Visibility="Collapsed" Background="#0D1C2A" BorderBrush="#40586F" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,14,0,0">
                <StackPanel><TextBlock x:Name="ProcessingHeading" Text="TRANSCRIÇÃO" Foreground="#59C7ED" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="ProcessingText" Text="Processando transcrição…" Foreground="#F5F7FA" FontSize="14" Margin="0,6,0,0"/></StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
