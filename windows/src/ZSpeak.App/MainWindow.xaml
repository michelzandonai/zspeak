<Window x:Class="ZSpeak.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zspeak para Windows" Width="680" Height="520"
        MinWidth="560" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="#111827" Foreground="#F9FAFB">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="zspeak" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Transcrição local com Parakeet TDT 0.6B V3" Foreground="#9CA3AF" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#1F2937" CornerRadius="10" Padding="16" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Status" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="Hotkey: Ctrl + Alt + Espaço (Toggle)" Foreground="#9CA3AF" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,18,0,16">
            <TextBlock Text="Microfone" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                      DisplayMemberPath="Name" IsEnabled="{Binding CanSelectMicrophone}" Height="34"/>
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Histórico local" FontWeight="SemiBold" FontSize="16"/>
            <ListBox Grid.Row="1" ItemsSource="{Binding History}" Margin="0,8,0,0" Background="#1F2937" Foreground="#F9FAFB" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
